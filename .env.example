# File: .env.example
# Copy this to .env and update with your values

# Environment (local, dev, staging, prod)
POD_ENV=local

# AWS Configuration
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Service Configuration
SERVICE_NAME=notification-engine

# Optional Environment Overrides (for local development)
DB_HOST=localhost
DB_PASSWORD=notification_pass
KAFKA_BROKERS=localhost:9092
GRAYLOG_ADDR=localhost:12201
JWT_SECRET=your-local-jwt-secret
KAFKA_API_KEY=your-local-kafka-key

# Database Configuration (for direct connection)
DB_PORT=3306
DB_USER=notification_user
DB_NAME=notification_db

# Server Configuration
SERVER_PORT=:8080

# ===================================
# File: .env.local
# Local development environment

POD_ENV=local
AWS_REGION=eu-central-1

# Local infrastructure
DB_HOST=localhost
DB_PASSWORD=notification_pass
KAFKA_BROKERS=localhost:9092
GRAYLOG_ADDR=localhost:12201

# Local test secrets
JWT_SECRET=local-development-secret-key
KAFKA_API_KEY=local-development-kafka-key

# ===================================
# File: .env.dev
# Development environment (uses AWS Parameter Store)

POD_ENV=dev
AWS_REGION=eu-central-1

# Optional overrides for dev environment
DB_HOST=dev-db-host.amazonaws.com
KAFKA_BROKERS=dev-kafka-cluster.amazonaws.com:9092

# ===================================
# File: .env.prod
# Production environment (uses AWS Parameter Store)

POD_ENV=prod
AWS_REGION=eu-central-1

# Production overrides (if needed)
# Most config should come from Parameter Store